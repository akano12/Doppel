# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
max_line_length = 140

# hooks.json is indented with 2 spaces
[*.json]
indent_size = 2

[*.bat]
end_of_line = crlf

# Vendored LuaJ keeps its upstream style
[app/src/main/java/org/luaj/**]
indent_style = tab
insert_final_newline = unset
trim_trailing_whitespace = false
