<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Listing and restricting any installed app is the purpose of the app -->
    <!-- https://developer.android.com/training/package-visibility -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Backups are off; the extraction rules of Android 12 and later exclude everything as well -->
    <application
        android:name=".ApplicationEx"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:appCategory="productivity"
        android:description="@string/app_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.XLua"
        tools:ignore="DataExtractionRules"
        tools:targetApi="33">

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/app_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="${xposedminversion}" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/scopes" />

        <!-- The libxposed service delivers its binder through this provider (declared by the library). Doppel's UI
             runs after unlock, so it need not start before, which would run ApplicationEx before credential storage -->
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:directBootAware="false"
            tools:ignore="ExportedContentProvider"
            tools:replace="android:directBootAware" />

        <activity
            android:name=".ActivityMain"
            android:exported="true"
            android:theme="@style/Theme.XLua.Starting"
            android:configChanges="orientation|screenSize"
            android:launchMode="singleTask" />

        <!-- The entries of the launcher, one per app icon, of which one is enabled, see LauncherIcons -->
        <activity-alias
            android:name=".IconMasks"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".ActivityMain">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconSplit"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_split"
            android:roundIcon="@mipmap/ic_launcher_split_round"
            android:targetActivity=".ActivityMain">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconTwoD"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_twod"
            android:roundIcon="@mipmap/ic_launcher_twod_round"
            android:targetActivity=".ActivityMain">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconEcho"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_echo"
            android:roundIcon="@mipmap/ic_launcher_echo_round"
            android:targetActivity=".ActivityMain">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ActivityApp"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".ActivityMain" />

        <activity
            android:name=".ActivityValues"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".ActivityMain"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ActivityLog"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".ActivityApp"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ActivityHookEdit"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".ActivityMain"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ActivityDownloads"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:parentActivityName=".ActivityMain"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
