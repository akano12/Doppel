  // The creators make the results of the extras of the intents of Play services also when the app reads them itself,
  // like by SafeParcelableSerializer.deserializeFromBytes, and the activity of the snapshots of Awareness
  // (DetectedActivityResponse), so every read agrees with extractResult.
  // shortcut: in apps R8 shrank, the creator of the activity keeps the real result (see its script) and the one of the
  // transitions, whose class R8 renames, does not install; the sleep events stay in their extras, a list of byte
  // arrays, which needs the extras of the intents the app gets, unparcelled with the class loader of the app before
  // Android 13; and DetectedActivityFence of Awareness follows the real activity, since fences of the fake unknown
  // activity would need to be always or never true; do these when apps read them
  {
    "collection": "Privacy",
    "group": "Determine.Activity",
    "name": "ActivityRecognitionResult.createFromParcel",
    "author": "akano12",
    "className": "com.google.android.gms.location.ActivityRecognitionResult",
    "methodName": "CREATOR:createFromParcel",
    "parameterTypes": [
      "android.os.Parcel"
    ],
    "returnType": "com.google.android.gms.location.ActivityRecognitionResult",
    "minSdk": 27,
    "optional": true,
    "luaScript": "@activityrecognitionresult_extractresult"
  },
