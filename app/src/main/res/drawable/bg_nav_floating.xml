<?xml version="1.0" encoding="utf-8"?>
<!-- The floating navigation bar: a pill, with an outline which the dark theme needs, where a shadow does not show -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/nav_floating_radius" />
    <solid android:color="?attr/colorSurfaceContainerLowest" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorOutlineVariant" />
</shape>
