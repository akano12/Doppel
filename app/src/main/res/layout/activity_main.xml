<?xml version="1.0" encoding="utf-8"?>
<!-- The tabs, with their bar floating over their bottom: lists scroll on behind it, see ActivityMain.keepClearOfBar -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <eu.faircode.xlua.NavBar
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_floating_height"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/nav_floating_margin_sides"
        android:layout_marginEnd="@dimen/nav_floating_margin_sides"
        android:layout_marginBottom="@dimen/nav_floating_margin"
        android:background="@drawable/bg_nav_floating"
        android:elevation="6dp"
        android:paddingStart="@dimen/nav_floating_padding"
        android:paddingEnd="@dimen/nav_floating_padding" />
</FrameLayout>
