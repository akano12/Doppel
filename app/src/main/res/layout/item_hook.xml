<?xml version="1.0" encoding="utf-8"?>
<!-- A hook definition under its group: the hooks of a group form an inset panel in the block of the groups,
     see FragmentHooks; the outer background and the panel are set from code -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:ignore="UselessParent">

    <LinearLayout
        android:id="@+id/llPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:orientation="vertical">

        <View
            android:id="@+id/vDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/plex_mono"
                    android:maxLines="2"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <TextView
                    android:id="@+id/tvClass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:textAppearance="@style/XLua.Text.Mono"
                    android:textSize="11sp" />

                <!-- Badges wrap to the next line instead of being cut off; the group itself is not a list for screen readers -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cgBadges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:importantForAccessibility="no"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="4dp" />
            </LinearLayout>

            <ImageView
                style="@style/XLua.Row.Icon"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
