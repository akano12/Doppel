<?xml version="1.0" encoding="utf-8"?>
<!-- Under a fake value: the group which reads it and whether it is restricted, with a dot in the color of the state,
     and the action to restrict it, see ActivityValues -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="28dp"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="0dp">

    <View
        android:id="@+id/vDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/bg_circle"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/tvHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:textAppearance="@style/XLua.Text.Meta" />

    <Button
        android:id="@+id/btnRestrict"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:text="@string/title_restrict"
        android:visibility="gone" />
</LinearLayout>
