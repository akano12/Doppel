<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/svContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <!-- The app, and all of its groups at once -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivIcon"
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:importantForAccessibility="no" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvPackage"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/XLua.Text.Mono"
                                    android:textIsSelectable="true" />

                                <!-- User or system, the uid and the version, see ActivityApp -->
                                <LinearLayout
                                    android:id="@+id/llBadges"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:orientation="horizontal" />
                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            app:dividerColor="?attr/colorOutlineVariant" />

                        <!-- The share of the groups restricted and the last call, with a dash when not all hooks are -->
                        <LinearLayout
                            android:id="@+id/llAll"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:minHeight="64dp"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="44dp"
                                android:layout_height="44dp">

                                <com.google.android.material.progressindicator.CircularProgressIndicator
                                    android:id="@+id/piAll"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:indeterminate="false"
                                    android:max="100"
                                    app:indicatorColor="?attr/colorPrimary"
                                    app:indicatorSize="44dp"
                                    app:trackColor="?attr/colorSurfaceContainerHigh"
                                    app:trackCornerRadius="3dp"
                                    app:trackThickness="5dp"
                                    tools:progress="100" />

                                <TextView
                                    android:id="@+id/tvAllCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:textAppearance="?attr/textAppearanceLabelMedium"
                                    android:textColor="?attr/colorOnSurface"
                                    tools:text="29" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/title_restrict_all_groups"
                                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                                <TextView
                                    android:id="@+id/tvSummary"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textAppearance="@style/XLua.Text.Meta"
                                    tools:text="29 of 29 groups restricted · last call Read VPN state, just now" />
                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/swAll"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:contentDescription="@string/title_restrict_all_groups" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Options of the app -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="@drawable/divider"
                        android:orientation="vertical"
                        android:showDividers="middle">

                        <LinearLayout
                            android:id="@+id/llForceStop"
                            style="@style/XLua.Row">

                            <LinearLayout style="@style/XLua.Row.Text">

                                <TextView
                                    style="@style/XLua.Row.Title"
                                    android:text="@string/title_force_stop" />

                                <TextView
                                    android:id="@+id/tvForceStop"
                                    style="@style/XLua.Row.Subtitle"
                                    android:text="@string/title_force_stop_hint" />
                            </LinearLayout>

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbForceStop"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="@string/title_force_stop" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/llNotify"
                            style="@style/XLua.Row">

                            <LinearLayout style="@style/XLua.Row.Text">

                                <TextView
                                    style="@style/XLua.Row.Title"
                                    android:text="@string/title_notify_usage" />

                                <TextView
                                    style="@style/XLua.Row.Subtitle"
                                    android:text="@string/title_notify_usage_hint" />
                            </LinearLayout>

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/cbNotify"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="@string/title_notify_usage" />
                        </LinearLayout>

                        <!-- Shown when groups with fake values can be restricted -->
                        <LinearLayout
                            android:id="@+id/llValues"
                            style="@style/XLua.Row"
                            android:visibility="gone">

                            <LinearLayout style="@style/XLua.Row.Text">

                                <TextView
                                    style="@style/XLua.Row.Title"
                                    android:text="@string/menu_values_app" />

                                <TextView
                                    android:id="@+id/tvValues"
                                    style="@style/XLua.Row.Subtitle"
                                    tools:text="3 own values, the rest from all apps" />
                            </LinearLayout>

                            <ImageView
                                style="@style/XLua.Row.Icon"
                                android:importantForAccessibility="no" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/llAndroid"
                    style="@style/XLua.Banner"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_error"
                        app:tint="?attr/colorWarning" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/title_bootloop"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnWarningContainer" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llRestart"
                    style="@style/XLua.Banner"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_restart"
                        app:tint="?attr/colorWarning" />

                    <TextView
                        android:id="@+id/tvRestart"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnWarningContainer" />

                    <Button
                        android:id="@+id/btnForceStop"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="?attr/colorWarning"
                        android:text="@string/title_force_stop_now"
                        android:textColor="?attr/colorWarningContainer" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llSections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/pbLoading"
            style="@style/XLua.Loading" />
    </FrameLayout>
</LinearLayout>
