<?xml version="1.0" encoding="utf-8"?>
<!-- A restriction or a failed hook in the log: the app, the time, the group and what changed;
     the rows of a day form one block, see FragmentLog -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical">

    <View
        android:id="@+id/vDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginTop="1dp"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvApp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textAppearance="@style/XLua.Text.Meta" />
            </LinearLayout>

            <!-- With the icon of the group, see FragmentLog -->
            <TextView
                android:id="@+id/tvWhat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <!-- The value before and after, when the hook changed one, and the hook -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvOld"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="120dp"
                    android:textAppearance="@style/XLua.Text.Mono"
                    android:visibility="gone"
                    tools:text="310260"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvArrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no"
                    android:text="@string/title_value_arrow"
                    android:textAppearance="@style/XLua.Text.Meta"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvNew"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="?attr/colorSecondaryContainer"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="120dp"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:textAppearance="@style/XLua.Text.Mono"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:visibility="gone"
                    tools:text="00101"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvHook"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:textAppearance="@style/XLua.Text.Mono"
                    android:textSize="11sp"
                    tools:text="TelephonyManager.getSimOperator" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
