<?xml version="1.0" encoding="utf-8"?>
<!-- Under the field of a fake value: the groups which read it, and the action of the value: Random for an
     identifier, Restrict for a group which reads it but does not restrict the app, see ActivityValues.bindHints -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    tools:ignore="RtlSymmetry">

    <TextView
        android:id="@+id/tvReaders"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/XLua.Text.Meta"
        tools:text="Read identifiers · 4 apps" />

    <Button
        android:id="@+id/btnRestrict"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:text="@string/title_restrict"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnRandom"
        style="@style/Widget.Material3.Button.TextButton.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:text="@string/title_random"
        android:visibility="gone"
        app:icon="@drawable/ic_shuffle" />
</LinearLayout>
