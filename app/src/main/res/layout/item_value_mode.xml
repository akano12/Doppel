<?xml version="1.0" encoding="utf-8"?>
<!-- An identifier of Fake values: fixed, like all apps (for an app) or new each boot, see ActivityValues.Mode;
     the choice goes next to the title in the row, the field of a fixed value follows the box, which tells what
     applies when the field is not shown -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Compact: the choices on a track, each rounded, the chosen one tinted -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/tgMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_segment_track"
        android:padding="3dp"
        android:spacing="2dp"
        app:innerCornerSize="11dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <Button
            android:id="@+id/btnInherit"
            style="@style/XLua.Segment"
            android:text="@string/title_mode_inherit" />

        <Button
            android:id="@+id/btnFixed"
            style="@style/XLua.Segment"
            android:text="@string/title_mode_fixed" />

        <Button
            android:id="@+id/btnBoot"
            style="@style/XLua.Segment"
            android:text="@string/title_mode_boot" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <LinearLayout
        android:id="@+id/llBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="0dp">

        <TextView
            android:id="@+id/tvBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/tvBoxValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/plex_mono"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textDirection="ltr"
            android:textIsSelectable="true" />

        <!-- A small switch at the end of its label -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/cbAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="44dp"
            android:text="@string/title_mode_all"
            android:textAppearance="?attr/textAppearanceBodyLarge" />
    </LinearLayout>
</LinearLayout>
